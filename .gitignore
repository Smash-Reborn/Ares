# Gradle build outputs and caches (regenerated by ./gradlew)
.gradle/
**/.gradle/
build/
**/build/
out/
.kotlin/

# Loom dev environment (regenerated by runClient / genSources)
run/

# IDE — local machine settings, never commit
.idea/
*.iml
*.ipr
*.iws
.vscode/
.cursor/

# Eclipse metadata (regenerated by gradlew eclipse / IDE sync)
.classpath
.project
.settings/
**/.classpath
**/.project
**/.settings/

# Downloaded third-party JARs (regenerated by gradlew :labymod-addon:downloadLabyModApi)
labymod-addon/libs/

# Local overrides and secrets — never commit
.env
.env.*
*.local
local.properties
gradle.properties.local
**/secrets/
**/*credentials*
**/*.pem
**/*.key

# Logs and crash dumps
*.log
hs_err_pid*
replay_pid*

# OS junk
.DS_Store
Thumbs.db
desktop.ini